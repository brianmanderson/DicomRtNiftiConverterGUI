<Project Sdk="Microsoft.NET.Sdk">

  <!-- SimpleITK native is needed at runtime now that the App invokes Core conversion services. -->
  <Import Project="..\SimpleITK.props" />

  <!--
    Cross-platform Avalonia desktop GUI (.NET 8), successor to the legacy WPF app.
    net8.0 / Nullable / version metadata come from ../Directory.Build.props.
    RootNamespace defaults to the assembly name (DicomRtNifti.App).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DicomRtNifti.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 11.3.x: 11.3.14+ depends on Tmds.DBus.Protocol 0.21.3, which closes
         GHSA-xrw6-gwf8-vvr9 (the 11.2 line stays on the vulnerable 0.20.0). Avalonia.Controls.DataGrid
         is published separately and its 11.x line ends at 11.3.13 (dependency range [11.3.13, )),
         so it deliberately lags the others. Keep tests/DicomRtNifti.App.Tests on the same version. -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DicomRtNifti.Core\DicomRtNifti.Core.csproj" />
  </ItemGroup>

</Project>
