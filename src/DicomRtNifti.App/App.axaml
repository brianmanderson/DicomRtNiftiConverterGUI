<!-- No RequestedThemeVariant: the app follows the OS light/dark setting. Theme.axaml carries
     both variants of every surface and text brush; windows read them with DynamicResource. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DicomRtNifti.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DicomRtNifti.App/Styles/Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Shared button hierarchy. Filled accent = the stage primary; red text = Stop. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentText}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentText}"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
    </Style>

    <!-- A small amber pill: "non-uniform Z", "link guessed". -->
    <Style Selector="Border.warningBadge">
      <Setter Property="Background" Value="{DynamicResource AppWarningBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="5,0,5,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.warningBadge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningText}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- A full-width amber note: the warning text behind a badge. -->
    <Style Selector="Border.warningNote">
      <Setter Property="Background" Value="{DynamicResource AppWarningBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Border.warningNote > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningText}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Application.Styles>
</Application>
