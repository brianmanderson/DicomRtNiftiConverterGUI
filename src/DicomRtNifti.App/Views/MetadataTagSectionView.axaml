<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DicomRtNifti.App.Views.MetadataTagSectionView">

  <!-- One picker tab: searchable checklist (left) + selected-tag summary (right).
       DataContext is a MetadataTagSectionViewModel. -->
  <Grid Margin="4,8,4,4" ColumnDefinitions="*,260">

    <!-- Left: searchable tag checklist (virtualized) -->
    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource AppBorder}"
            BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{StaticResource AppSurfaceAlt}" BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="4,4,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <CheckBox Grid.Column="0" Content="Select all (filtered)" IsChecked="{Binding AllSelected}"
                      FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppHeadingText}"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectionSummaryText}" FontWeight="Medium" FontSize="11"
                       Foreground="{StaticResource AppHintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8,8,8,4" ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search by keyword, name, or tag…"
                   Padding="6,4" BorderBrush="{StaticResource AppBorderAlt}" VerticalContentAlignment="Center"/>
          <CheckBox Grid.Column="1" Content="Show all tags" IsChecked="{Binding ShowAllTags}"
                    Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                    Foreground="{StaticResource AppHeadingText}"/>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredItems}" Background="Transparent"
                 BorderThickness="0" Padding="4"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <!-- Render rows as a plain checklist (no selection highlight). -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="Transparent"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected}" Margin="8,2">
                <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource AppHeadingText}"
                           TextTrimming="CharacterEllipsis"/>
              </CheckBox>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Right: selected summary -->
    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="4">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{StaticResource AppSurfaceAlt}" BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4,4,0,0">
          <TextBlock Text="Selected" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppHeadingText}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4">
          <ItemsControl ItemsSource="{Binding SelectedSummaryItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource AppWindowBg}" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="3" Margin="4,2" Padding="8,5">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontWeight="Medium"
                               FontSize="12" Foreground="{StaticResource AppHeadingText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Badge}" FontSize="11"
                               Foreground="{StaticResource AppBadgeText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
