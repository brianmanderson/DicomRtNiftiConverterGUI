<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dicom_RT_images_Csharp.Views.AnonymizationKeyEditorWindow"
        Title="Edit Anonymization Key" Width="780" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <Border Grid.Row="0" Background="#455A64" Padding="16,12">
      <StackPanel>
        <TextBlock Text="Anonymization Key Editor" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="View and override the input → hash mappings used for anonymized exports. Edit a Hash cell (or add a row) to pin a specific output hash for a given MRN, Study UID, or Series UID."
                   FontSize="11" Foreground="#CFD8DC" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,0,0,1" Padding="12,6">
      <TextBlock Text="{Binding FileStatus}" FontSize="11" Foreground="#37474F" TextWrapping="Wrap"/>
    </Border>

    <TabControl Grid.Row="2" Margin="12,12,12,0">

      <TabItem Header="Patients (MRN)">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Add" Command="{Binding AddPatientCommand}" Width="80" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Delete Selected" Command="{Binding DeletePatientCommand}" Width="130" Padding="10,5"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Background="White">
            <DataGrid ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                      AutoGenerateColumns="False" IsReadOnly="False" CanUserResizeColumns="True"
                      GridLinesVisibility="All" HeadersVisibility="Column" FontSize="12">
              <DataGrid.Columns>
                <DataGridTextColumn Header="MRN (input)" Binding="{Binding Input, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn Header="Patient Hash (output)" Binding="{Binding Hash, Mode=TwoWay}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Studies (Study UID)">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Add" Command="{Binding AddStudyCommand}" Width="80" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Delete Selected" Command="{Binding DeleteStudyCommand}" Width="130" Padding="10,5"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Background="White">
            <DataGrid ItemsSource="{Binding Studies}" SelectedItem="{Binding SelectedStudy}"
                      AutoGenerateColumns="False" IsReadOnly="False" CanUserResizeColumns="True"
                      GridLinesVisibility="All" HeadersVisibility="Column" FontSize="12">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Study UID (input)" Binding="{Binding Input, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn Header="Study Hash (output)" Binding="{Binding Hash, Mode=TwoWay}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Series (Series UID)">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Add" Command="{Binding AddSeriesCommand}" Width="80" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Delete Selected" Command="{Binding DeleteSeriesCommand}" Width="130" Padding="10,5"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Background="White">
            <DataGrid ItemsSource="{Binding Series}" SelectedItem="{Binding SelectedSeries}"
                      AutoGenerateColumns="False" IsReadOnly="False" CanUserResizeColumns="True"
                      GridLinesVisibility="All" HeadersVisibility="Column" FontSize="12">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Series UID (input)" Binding="{Binding Input, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn Header="Series Hash (output)" Binding="{Binding Hash, Mode=TwoWay}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>

    <TextBlock Grid.Row="3" Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
               Foreground="#D32F2F" FontSize="12" TextWrapping="Wrap" Margin="16,8,16,0"/>

    <Border Grid.Row="4" Background="#F0F0F0" BorderBrush="#CCCCCC"
            BorderThickness="0,1,0,0" Padding="12,8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" Click="SaveButton_Click" Width="90" Padding="12,6"
                IsDefault="True" Margin="0,0,8,0"
                Background="#455A64" Foreground="White" FontWeight="SemiBold"/>
        <Button Content="Cancel" Click="CancelButton_Click" Width="90" Padding="12,6" IsCancel="True"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
