<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DicomRtNifti.App.ViewModels"
        xmlns:views="clr-namespace:DicomRtNifti.App.Views"
        x:Class="DicomRtNifti.App.Views.DicomToNiftiWindow"
        Title="DICOM → NIfTI" Width="1240" Height="850"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBg}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource AppAccentBrush}" Padding="16,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Help" Command="{Binding OpenHelpCommand}"
                VerticalAlignment="Center" Padding="14,6" Background="{DynamicResource AppOnAccentButtonBg}" Foreground="{DynamicResource AppAccentBrush}"
                FontWeight="SemiBold" FontSize="13" MinWidth="80" BorderThickness="0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DICOM → NIfTI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppOnAccentText}"/>
          <TextBlock Text="Scan an archive, pick the patients and series you want, export to NIfTI"
                     FontSize="12" Foreground="{DynamicResource AppOnAccentSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Input/Output/Scan toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource AppToolbarBg}" BorderBrush="{DynamicResource AppBorderAlt}" BorderThickness="0,0,0,1" Padding="12,10">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="55,*,Auto">
          <TextBlock Grid.Column="0" Text="Input:" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AppLabelText}"/>
          <TextBox Grid.Column="1" Text="{Binding InputFolder}" VerticalContentAlignment="Center" Padding="6,4"/>
          <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseInputCommand}"
                  Padding="12,6" MinWidth="80" FontSize="13" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,6" ColumnDefinitions="55,*,Auto">
          <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AppLabelText}"/>
          <TextBox Grid.Column="1" Text="{Binding OutputFolder}" VerticalContentAlignment="Center" Padding="6,4"/>
          <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseOutputCommand}"
                  Padding="12,6" MinWidth="80" FontSize="13" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,6" ColumnDefinitions="Auto,Auto,*">
          <Button Grid.Column="0" Content="Scan" Command="{Binding ScanCommand}"
                  Padding="12,6" MinWidth="100" FontSize="13" Margin="0,0,5,0"
                  Classes="primary"/>
          <Button Grid.Column="1" Content="Stop" Command="{Binding CancelCommand}"
                  Padding="12,6" MinWidth="80" FontSize="13" Margin="5,0"
                  Classes="danger"/>
          <Grid Grid.Column="2" Margin="16,0,0,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                         Height="18" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppMutedText}" MinWidth="110"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Patient / Study / Series tree, and the series inspector beside it -->
    <Grid Grid.Row="2" Margin="12" ColumnDefinitions="3*,8,2*">
    <Border Grid.Column="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
            CornerRadius="4" MinWidth="360">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource AppSurfaceAlt}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1"
                  Padding="12,8" CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Patient / Study / Series" FontWeight="SemiBold"
                         FontSize="13" Foreground="{DynamicResource AppHeadingText}" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" Content="Select all" IsChecked="{Binding AllPatientsSelected}"
                        VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppLabelText}"/>
            </Grid>
          </Border>

          <TreeView Grid.Row="1" ItemsSource="{Binding Patients}" Background="Transparent" Padding="8"
                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:PatientGroupViewModel" ItemsSource="{Binding Studies}">
                <StackPanel Orientation="Horizontal">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="[P]" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource AppAccentBrush}"
                             FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                  <Border Classes="warningBadge" Margin="8,0,0,0" IsVisible="{Binding HasNonUniformSeries}"
                          ToolTip.Tip="Series of this patient have non-uniform slice spacing. Expand to see which.">
                    <TextBlock Text="{Binding NonUniformBadgeText}"/>
                  </Border>
                  <Border Classes="warningBadge" Margin="6,0,0,0" IsVisible="{Binding HasGuessedLinkSeries}"
                          ToolTip.Tip="An RTSTRUCT or RTDOSE of this patient was linked by the largest-series fallback. Expand to see which series.">
                    <TextBlock Text="{Binding GuessedLinkBadgeText}"/>
                  </Border>
                </StackPanel>
              </TreeDataTemplate>

              <TreeDataTemplate DataType="vm:StudyGroupViewModel" ItemsSource="{Binding ImageSeries}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="[S]" Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource AppBadgeText}"
                             FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding DisplayName}" FontStyle="Italic" VerticalAlignment="Center"/>
                </StackPanel>
              </TreeDataTemplate>

              <DataTemplate DataType="vm:SeriesGroupViewModel">
                <StackPanel Margin="0,2">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.Modality, StringFormat='[{0}]'}" Margin="0,0,6,0"
                               FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Classes="warningBadge" Margin="8,0,0,0" IsVisible="{Binding IsNonUniformZ}"
                            ToolTip.Tip="{Binding NonUniformZWarning}">
                      <TextBlock Text="non-uniform Z"/>
                    </Border>
                    <Border Classes="warningBadge" Margin="6,0,0,0" IsVisible="{Binding HasGuessedLink}"
                            ToolTip.Tip="An RTSTRUCT or RTDOSE was linked to this series by the largest-series fallback: nothing in it identified its image series. Select the series to see the links.">
                      <TextBlock Text="link guessed"/>
                    </Border>
                  </StackPanel>
                  <Expander Header="ROI Names" Margin="20,2,0,0"
                            IsVisible="{Binding HasLinkedRtStruct}" IsExpanded="{Binding IsExpanded}">
                    <ItemsControl ItemsSource="{Binding RoiNames}" Margin="16,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource AppLabelText}" FontSize="11"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                  <StackPanel Orientation="Horizontal" Margin="20,2,0,0" IsVisible="{Binding HasLinkedRtDose}">
                    <TextBlock Text="[RTDOSE]" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LinkedRtDoseLabel}" FontSize="11" Foreground="{DynamicResource AppLabelText}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

          <!-- Empty-state hint: shown until a scan populates the tree. -->
          <TextBlock Grid.Row="1" Text="Set an input folder and click Scan to list patients here."
                     IsVisible="{Binding ShowTreeEmptyHint}" IsHitTestVisible="False"
                     Foreground="{DynamicResource AppHintText}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                     MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

    <!-- Series inspector: geometry, links and tags of the series selected in the tree. -->
    <Border Grid.Column="2" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
            CornerRadius="4" MinWidth="300">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceAlt}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1"
                Padding="12,8" CornerRadius="4,4,0,0">
          <TextBlock Text="Series inspector" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppHeadingText}"/>
        </Border>
        <ContentControl Grid.Row="1" x:Name="InspectorHost" Content="{Binding SelectedInspector}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SeriesInspectorViewModel">
              <views:SeriesInspectorView/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock Grid.Row="1" Text="Select a series in the tree to see its slice spacing, gaps, extent, frame of reference, how its RTSTRUCT and RTDOSE were linked, and its DICOM tags."
                   IsVisible="{Binding ShowInspectorHint}" IsHitTestVisible="False"
                   Foreground="{DynamicResource AppHintText}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    </Grid>

    <!-- Action bar + log -->
    <Border Grid.Row="3" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Margin="12,0" Padding="12">
      <StackPanel>
        <!-- Data to export + Export Options, sitting directly above the run actions. -->
        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Data to export:" VerticalAlignment="Center"
                     FontWeight="Medium" Foreground="{DynamicResource AppLabelText}" Margin="0,0,16,0"/>
          <CheckBox Grid.Column="1" Content="Export Images" IsChecked="{Binding ExportImages}"
                    FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Content="Export Structures" IsChecked="{Binding IncludeStructures}"
                    FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="3" Content="Export Dose" IsChecked="{Binding IncludeDose}"
                    FontSize="13" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding ExportOptionsSummary}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="11"
                     Foreground="{DynamicResource AppMutedText}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="Current Export Options. Click Export Options... to change."/>
          <Button Grid.Column="5" Content="Export Options..." Command="{Binding OpenExportOptionsCommand}"
                  Padding="14,6" FontSize="13"/>
        </Grid>

        <Border Margin="0,0,0,8" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"/>

        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,Auto,Auto,*">
          <Button Grid.Column="0" Content="Convert Selected" Command="{Binding ConvertSelectedCommand}"
                  Padding="12,6" MinWidth="140" FontSize="13" Margin="0,0,5,0"
                  Classes="primary"/>
          <Button Grid.Column="1" Content="Export Manifest Only" Command="{Binding ExportMetaDataCommand}"
                  Padding="12,6" MinWidth="140" FontSize="13" Margin="5,0"/>
          <Button Grid.Column="2" Content="Settings..." Command="{Binding OpenSettingsCommand}"
                  Padding="12,6" MinWidth="80" FontSize="13" Margin="5,0"/>
        </Grid>
        <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Height="120" FontFamily="Consolas" FontSize="11"
                 TextWrapping="Wrap" AcceptsReturn="True" TextChanged="LogTextBox_TextChanged"
                 Background="{DynamicResource AppSurfaceAlt}" BorderBrush="{DynamicResource AppBorderSubtle}" Padding="8"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
