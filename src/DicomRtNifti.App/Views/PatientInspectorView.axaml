<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DicomRtNifti.App.Views.PatientInspectorView">
  <!-- DataContext: a PatientInspectorViewModel (the patient selected in the forward window's tree). -->
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource AppLabelText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,12,4"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock.value, SelectableTextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource AppBodyText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource AppHeadingText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
  </UserControl.Styles>

  <TabControl Padding="0">
    <TabItem Header="Summary">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8,12,12">

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="[P]" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppHeadingText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <WrapPanel Margin="0,0,0,8">
            <Border Classes="warningBadge" Margin="0,0,6,4" IsVisible="{Binding HasNonUniformSeries}"
                    ToolTip.Tip="Image series of this patient have non-uniform slice spacing. Select a study or series to see which.">
              <TextBlock Text="{Binding NonUniformBadgeText}"/>
            </Border>
            <Border Classes="warningBadge" Margin="0,0,6,4" IsVisible="{Binding HasGuessedLinkSeries}"
                    ToolTip.Tip="An RTSTRUCT or RTDOSE of this patient was linked by the largest-series fallback. Select a study or series to see which.">
              <TextBlock Text="{Binding GuessedLinkBadgeText}"/>
            </Border>
            <Border Classes="warningBadge" Margin="0,0,6,4" IsVisible="{Binding HasUnlinkedObjects}">
              <TextBlock Text="{Binding UnlinkedBadgeText}"/>
            </Border>
          </WrapPanel>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Patient ID"/>
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding PatientId}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Patient name"/>
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding PatientName}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Studies"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding StudyCount}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Image series"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ImageSeriesSummary}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Image instances"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding ImageInstanceCount}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="RTSTRUCT"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding RtStructText}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="RTDOSE"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding RtDoseText}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Other objects"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Classes="value" Text="{Binding OtherObjectsText}"/>
          </Grid>

          <Border Classes="warningNote" Margin="0,6,0,0" IsVisible="{Binding HasUnlinkedObjects}">
            <TextBlock Text="{Binding UnlinkedObjectsNote}"/>
          </Border>

          <TextBlock Classes="section" Text="Studies"/>
          <ItemsControl ItemsSource="{Binding Studies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DateText}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppBodyText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Classes="warningBadge" Margin="6,0,0,0" IsVisible="{Binding HasUnlinkedObjects}">
                      <TextBlock Text="{Binding UnlinkedBadgeText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,1,0,0"
                             Foreground="{DynamicResource AppMutedText}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="DICOM tags">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Margin="12,8,12,4" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedText}"
                   Text="Curated patient attributes from the first slice of the patient's first image series (with no image series, the first file of an RT object): the patient rows of the list the metadata.json sidecar offers. Read-only."/>
        <TextBlock Grid.Row="1" Margin="12,4" FontSize="12" Foreground="{DynamicResource AppHintText}"
                   Text="{Binding TagStatus}" IsVisible="{Binding HasTagStatus}"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="Transparent" FontSize="12" Margin="4,0,4,4"
                  IsVisible="{Binding !HasTagStatus}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="100"/>
            <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="160"/>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
