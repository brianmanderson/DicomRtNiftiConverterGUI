<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DicomRtNifti.App.Views.LauncherWindow"
        Title="DICOM RT Toolkit" Width="480" Height="392"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource AppWindowBg}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header bar -->
    <Border Grid.Row="0" Background="{StaticResource AppAccentBrush}" Padding="16,12">
      <StackPanel>
        <TextBlock Text="DICOM RT Toolkit" FontSize="18" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Pick a workflow to begin" FontSize="12" Foreground="{StaticResource AppOnAccentSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Workflow buttons -->
    <Grid Grid.Row="1" Margin="20" RowDefinitions="*,*">

      <Button Grid.Row="0" Command="{Binding OpenDicomToNiftiCommand}"
              Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Background="{StaticResource AppAccentBrush}" Foreground="White" BorderThickness="0">
        <StackPanel Margin="14,8">
          <TextBlock Text="DICOM → NIfTI" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock FontSize="11" Foreground="#E3F2FD" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Convert DICOM RT-STRUCT, CT/MR/PT image series, and RT-DOSE into NIfTI files."/>
        </StackPanel>
      </Button>

      <Button Grid.Row="1" Command="{Binding OpenNiftiToDicomCommand}"
              Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Background="{StaticResource AppAccentBrush}" Foreground="White" BorderThickness="0">
        <StackPanel Margin="14,8">
          <TextBlock Text="NIfTI → DICOM" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock FontSize="11" Foreground="#E3F2FD" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Convert NIfTI image, masks, and dose back into standards-compliant DICOM (batch)."/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Footer: version, licence, and a citation pointer for the published toolkit. -->
    <Border Grid.Row="2" Background="{StaticResource AppSurfaceAlt}" BorderBrush="{StaticResource AppBorder}"
            BorderThickness="0,1,0,0" Padding="16,8">
      <StackPanel>
        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource AppMutedText}"/>
        <TextBlock FontSize="11" Foreground="{StaticResource AppHintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="If you use this tool in published work, please cite the accompanying CMPB publication."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
