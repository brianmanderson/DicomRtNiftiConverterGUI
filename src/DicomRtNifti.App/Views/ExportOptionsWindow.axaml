<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DicomRtNifti.App.Views.ExportOptionsWindow"
        Title="Export Options" Width="600" Height="860"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBg}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource AppAccentBrush}" Padding="16,10">
      <StackPanel>
        <TextBlock Text="Export Options" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppOnAccentText}"/>
        <TextBlock Text="Series selection, ROI filtering, output spacing, and anonymization. Stays open while you work."
                   Foreground="{DynamicResource AppOnAccentSubtitle}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Options -->
    <Border Grid.Row="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
            CornerRadius="4" Margin="12,12,12,0" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Series selection (narrows the ticked series)" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource AppHeadingText}" Margin="4,4,4,2"/>
          <CheckBox x:Name="RequireStructuresCheckBox" Content="Require a structure set (skip series without an RT-STRUCT)"
                    IsChecked="{Binding RequireStructures}" Margin="4,4" FontSize="13"/>
          <CheckBox x:Name="RequireDoseCheckBox" Content="Require a dose (skip series without an RT-DOSE)"
                    IsChecked="{Binding RequireDose}" Margin="4,4" FontSize="13"/>
          <TextBlock Text="Series description contains" FontSize="12"
                     Foreground="{DynamicResource AppHeadingText}" Margin="4,8,4,2"/>
          <TextBox x:Name="SeriesDescriptionFilterBox" Text="{Binding SeriesDescriptionFilter, UpdateSourceTrigger=LostFocus}"
                   Watermark="Empty: every description" FontSize="12" Margin="4,0,4,4"/>
          <TextBlock Text="Structure set description contains" FontSize="12"
                     Foreground="{DynamicResource AppHeadingText}" Margin="4,4,4,2"/>
          <TextBox x:Name="StructDescriptionFilterBox" Text="{Binding StructDescriptionFilter, UpdateSourceTrigger=LostFocus}"
                   Watermark="Empty: every structure set" FontSize="12" Margin="4,0,4,4"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,0"
                     Text="Of the series ticked in the tree, only those that pass every rule here are exported; matching is case-insensitive. A series with several structure sets exports the one the structure-set filter matches, unless you pick one on its row in the tree. Convert Selected lists every series these rules skip, with the reason, before it starts."/>

          <Separator Margin="0,12"/>

          <TextBlock Text="ROI renaming (always applies)" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource AppHeadingText}" Margin="4,4,4,2"/>
          <Button Content="Edit ROI Associations..." Command="{Binding ManageAssociationsCommand}"
                  Padding="12,8" Margin="4" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,4"
                     Text="ROI Associations always apply — matching ROIs are renamed to their canonical names during export, whether or not the filter below is on."/>

          <Separator Margin="0,12"/>

          <CheckBox Content="Limit export to selected ROIs" IsChecked="{Binding OnlyExportSpecificRois}" Margin="4,8" FontSize="13"/>
          <Button Content="Select ROIs for Export..." Command="{Binding SelectRoisCommand}"
                  IsEnabled="{Binding OnlyExportSpecificRois}"
                  Padding="12,8" Margin="4,4,4,12" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,0"
                     Text="When checked, only ROIs matching associations are exported. Use 'Select ROIs for Export' to choose which to include: a selected name keeps its association's aliases, a name no association carries matches itself, and every other ROI is dropped. Patients missing all selected ROIs are automatically de-selected."/>

          <Separator Margin="0,12"/>

          <CheckBox Content="Resample to fixed spacing" IsChecked="{Binding SpecifyOutputSpacing}" Margin="4,8" FontSize="13"/>
          <Button Content="Set Spacing..." Command="{Binding OpenOutputSpacingCommand}"
                  IsEnabled="{Binding SpecifyOutputSpacing}"
                  Padding="12,8" Margin="4" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,4,4,0"
                     Text="When enabled, all exports (image, dose, masks) are resampled to the specified X/Y/Z voxel size. Image and dose use linear interpolation; structure masks use nearest-neighbor."/>

          <Separator Margin="0,12"/>

          <CheckBox Content="Anonymize export" IsChecked="{Binding AnonymizeExport}" Margin="4,8" FontSize="13"/>
          <Button Content="Edit Anonymization Key..." Command="{Binding OpenAnonymizationKeyEditorCommand}"
                  IsEnabled="{Binding AnonymizeExport}"
                  Padding="12,8" Margin="4,4,4,12" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,8"
                     Text="When checked, exports use hashed folder IDs instead of patient names. AnonymizationKey.json maps every hash back to its MRN / Study UID / Series UID across sessions. It is written outside the export, so sharing the export folder does not share the key."/>
          <TextBlock Text="Key location (empty: a folder beside the export, &lt;output folder&gt;.key)" FontSize="12"
                     Foreground="{DynamicResource AppHeadingText}" Margin="4,4,4,2" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,4" IsEnabled="{Binding AnonymizeExport}">
            <TextBox Grid.Column="0" Text="{Binding AnonymizationKeyPath, UpdateSourceTrigger=LostFocus}"
                     Watermark="Default: beside the export" FontSize="12"/>
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseAnonymizationKeyFolderCommand}"
                    Padding="10,4" Margin="6,0,0,0" FontSize="12"/>
          </Grid>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,0"
                     Text="{Binding AnonymizationKeyLocationText}"/>

          <Separator Margin="0,12"/>

          <CheckBox Content="Write DICOM tag sidecar (metadata.json)" IsChecked="{Binding ExportDicomMetadata}" Margin="4,8" FontSize="13"/>
          <Button Content="Select Metadata Tags..." Command="{Binding OpenMetadataTagsCommand}"
                  IsEnabled="{Binding ExportDicomMetadata}"
                  Padding="12,8" Margin="4,4,4,12" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,4"
                     Text="When checked, a metadata.json with your selected DICOM tags is written into every export folder. Tags are read from each series' first image; numeric tags become numbers, multi-valued tags become arrays, and tags missing from a series are written as null."/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedText}" Margin="4,0,4,0"
                     Text="When anonymizing, the sidecar is de-identified: Patient ID and the Study and Series Instance UIDs carry the export's hashes, and names, dates, times, ages, instance UIDs and identifying attributes (IDs, addresses, institution, device) are written as null."/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource AppToolbarBg}" BorderBrush="{DynamicResource AppBorderAlt}"
            BorderThickness="0,1,0,0" Padding="12,8" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" Click="CloseButton_Click" Width="90" Padding="12,6" IsCancel="True"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
