<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\SimpleITK.props" />

  <PropertyGroup>
    <AssemblyName>DicomRtNifti.Core</AssemblyName>
    <!-- RootNamespace kept on the legacy value for this commit; the namespace
         modernization to DicomRtNifti.Core.* lands as a separate change. -->
    <RootNamespace>Dicom_RT_images_Csharp</RootNamespace>
  </PropertyGroup>

  <!-- Some service helpers (e.g. NiftiFileNaming) are `internal`; they were accessible when
       everything was one assembly. The CLI and Avalonia app are separate assemblies, so
       grant them access rather than widening these types' visibility. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DicomRtNifti.Cli" />
    <InternalsVisibleTo Include="DicomRtNifti.App" />
    <InternalsVisibleTo Include="DicomRtNifti.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fo-dicom" Version="5.2.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
  </ItemGroup>

</Project>
