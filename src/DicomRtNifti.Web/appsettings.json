{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Loopback only (D-33): the binding guard refuses to start on any other address until
  // authentication is configured. Restricting the Host header as well keeps a page on another
  // site from reaching this server through DNS rebinding.
  "Urls": "http://localhost:5180",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",

  // Server settings (WebOptions). This repository is public and holds no real path; configure
  // the roots on the server, here or as environment variables (Web__DataRoots__0__Id, ...).
  // An example, with illustrative paths:
  //
  //   "DataRoots": [
  //     { "Id": "archive",   "Path": "/srv/dicom",     "Access": "Read" },
  //     { "Id": "predicted", "Path": "/srv/predicted", "Access": "ReadWrite" }
  //   ],
  //   "OutputRoot": "/srv/exports",
  //   "KeyRoot":    "/srv/keys",
  //   "UploadRoot": "/srv/uploads",
  //   "StateRoot":  "/srv/dicomrtnifti-state",
  "Web": {
    "DataRoots": [],
    "Limits": {
      "UploadBytes": 536870912,
      "DownloadZipBytes": 4294967296,
      "UploadRetentionHours": 24
    },
    "Lanes": {
      "MaxHeavyWorkers": 1,
      "MaxLightWorkers": 1,
      "QueueCapacity": 16
    }
  }
}
