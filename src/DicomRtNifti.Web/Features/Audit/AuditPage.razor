@page "/audit"
@inject FeatureCatalog Catalog

@* Plan section 4.15. The body is AuditView, which carries the page's scoped styles, so this
   page's own markup stays plain. *@

<PageTitle>Audit · DicomRtNifti</PageTitle>

<h1>Audit</h1>
<p class="summary">@_feature.Feature.Summary</p>

<AuditView />

<h2>CLI equivalent</h2>
<CliCommand Cli="_feature.Feature.Cli" />

@code {
    private FeatureDescriptor _feature = default!;

    protected override void OnInitialized() => _feature = Catalog.For(typeof(AuditFeature));
}
