<Project>

  <!--
    Shared metadata for the cross-platform (.NET 8) projects under src/.

    Deliberately scoped to src/ (NOT the repo root) so the legacy .NET Framework 4.8
    WPF project at ../Dicom_RT_images_Csharp is NOT affected during the migration.
    Single source of version/author truth (replaces the hand-edited
    Dicom_RT_images_Csharp/Properties/AssemblyInfo.cs).
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Brian Mark Anderson</Authors>
    <Company>University of California, San Diego</Company>
    <Product>DICOM RT Toolkit</Product>
    <Copyright>Copyright © 2026</Copyright>
    <RepositoryUrl>https://github.com/brianmanderson/DicomRtNiftiConverterGUI</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Leave Nullable/ImplicitUsings OFF: the linked legacy service files were written
         for C# 7.3 / net48 and are not annotated; enabling them would flood the build with
         warnings. Re-enable per-project once the code is migrated in. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- The informational version is "1.0.0+<commit sha>" (what the CLI prints for its version flag and
         the launcher footer shows). The SDK only appends the sha when Source Link can read the git
         metadata; this pins the opt-in, and the RequireSourceRevision target below turns a build
         that cannot determine its commit (a source tarball, a checkout without .git) into an error
         instead of a bare "1.0.0" that cannot be traced. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release bundles must carry the licence and the third-party notices (Apache-2.0 section 4 for
       SimpleITK, MS-PL for fo-dicom). Copying them as content of the two executables puts them in
       every build output and in `dotnet publish` output; the Core library needs neither. -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Fail the build when the commit cannot be determined. Opt out with
       -p:AllowMissingSourceRevision=true for a deliberate build from a tarball; the binaries then
       report a bare "1.0.0". SourceRevisionId is filled in at execution time by the SDK's implicit
       Source Link git query (InitializeSourceControlInformation), so the check has to be a Target
       that runs after it rather than a property condition. -->
  <Target Name="RequireSourceRevision"
          BeforeTargets="GetAssemblyVersion"
          DependsOnTargets="InitializeSourceControlInformation"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(AllowMissingSourceRevision)' != 'true'">
    <Error Condition="'$(SourceRevisionId)' == ''"
           Text="Cannot determine the commit this build comes from (SourceRevisionId is empty), so the informational version would be a bare $(Version). Build from a git checkout, or pass -p:AllowMissingSourceRevision=true to accept an untraceable build." />
  </Target>

</Project>
